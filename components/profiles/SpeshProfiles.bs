import "pkg:/source/utils/speshProfiles.bs"
sub init()
    m.tiles = m.top.findNode("tiles")
    m.status = m.top.findNode("status")
    m.profiles = []
    m.index = 0
    m.manage = false
    m.mode = "profiles"
    m.busy = false
    m.compatible = false
end sub

sub beginProfiles()
    m.top.setFocus(true)
    requestProfiles("list")
end sub

sub requestProfiles(op as string)
    m.busy = true
    m.status.text = "Loading profiles…"
    task = CreateObject("roSGNode", "SpeshProfilesTask")
    data = {op:op,owner:m.top.owner,serverUrl:m.top.serverUrl}
    if op = "select" then data.profileId = m.profiles[m.index].id
    if op = "create" or op = "edit"
        data.profileId = m.edit.id
        data.name = m.edit.name
        data.avatar = speshProfiles.Avatars()[m.index]
    end if
    task.request = data
    task.observeField("reply", "onReply")
    m.task = task
    task.control = "RUN"
end sub

sub onReply(event as object)
    if not isValid(m.task) or not event.getRoSGNode().isSameNode(m.task) then return
    answer = event.getData()
    m.task.unobserveField("reply")
    m.task = invalid
    m.busy = false
    if not answer.ok
        if answer.op = "list" and (answer.status = 404 or answer.status = 405 or answer.status = 501)
            m.compatible = true
            m.status.text = "Viewing profiles require SpeshTV Core 3.1.0.9 or newer. Press OK to continue with your original account, or Back to return."
            return
        end if
        m.mode = "profiles"
        draw()
        m.status.text = answer.error + " · Press * to refresh."
        return
    end if
    m.status.text = ""
    if answer.op = "select"
        m.top.selected = answer.data
    else if answer.op = "list"
        m.profiles = answer.data.profiles
        m.mode = "profiles"
        if m.index >= m.profiles.count() then m.index = 0
        draw()
    else
        m.mode = "profiles"
        m.index = 0
        requestProfiles("list")
    end if
end sub

sub draw()
    m.tiles.removeChildrenIndex(m.tiles.getChildCount(), 0)
    m.top.findNode("heading").text = m.manage ? "Manage profiles" : "Who’s watching?"
    count = m.profiles.count()
    if m.mode = "avatars" then count = 8
    if m.mode = "profiles" and count < 3 then count++
    rowCount = count
    if rowCount > 4 then rowCount = 4
    rowLeft = (1920 - (rowCount * 280 - 90)) / 2
    for i = 0 to count - 1
        row = int(i / 4)
        col = i mod 4
        group = m.tiles.createChild("Group")
        group.translation = [rowLeft + col * 280, 390 + row * 220]
        ring = group.createChild("Rectangle")
        ring.width = 190
        ring.height = 190
        ring.color = i = m.index ? "#8ABCF4" : "#25272C"
        face = group.createChild("Rectangle")
        face.translation = [5,5]
        face.width = 180
        face.height = 180
        title = "Add profile"
        avatar = "slate"
        if m.mode = "avatars"
            avatar = speshProfiles.Avatars()[i]
            title = avatar
        else if i < m.profiles.count()
            title = m.profiles[i].name
            avatar = m.profiles[i].avatar
        end if
        face.color = speshProfiles.Color(avatar)
        for each x in [48,120]
            eye = group.createChild("Rectangle")
            eye.translation = [x,60]
            eye.width = 18
            eye.height = 24
            eye.color = "#F3F5F6"
        end for
        smile = group.createChild("Rectangle")
        smile.translation = [60,120]
        smile.width = 70
        smile.height = 12
        smile.color = "#F3F5F6"
        label = group.createChild("Label")
        label.text = title
        label.color = "#F3F5F6"
        label.font = "font:SmallSystemFont"
        label.width = 250
        label.horizAlign = "center"
        label.translation = [-30,192]
    end for
    if m.mode = "avatars"
        m.top.findNode("heading").text = "Choose an avatar"
        m.top.findNode("help").text = "Arrows: choose avatar · OK: save profile · Back: cancel"
    else if m.manage
        m.top.findNode("help").text = "Left/Right: choose profile · OK: edit name and avatar · Back: finish"
    else
        m.top.findNode("help").text = "OK: choose · Down: manage profiles · Back: return"
    end if
end sub

sub editName()
    m.keyboard = CreateObject("roSGNode", "TVKeyboard")
    ' TVKeyboard builds its keys on the hidden-to-visible transition.
    m.keyboard.visible = false
    m.keyboard.titleText = "Profile name (1–24 characters)"
    m.keyboard.text = m.edit.name
    m.keyboard.returnFocus = m.top
    m.keyboard.observeField("submitted", "onName")
    m.keyboard.observeField("cancelled", "onNameCancelled")
    m.top.appendChild(m.keyboard)
    m.mode = "keyboard"
    m.keyboard.visible = true
    m.keyboard.setFocus(true)
end sub

sub closeKeyboard()
    m.keyboard.visible = false
    m.keyboard.unobserveField("submitted")
    m.keyboard.unobserveField("cancelled")
    m.top.removeChild(m.keyboard)
    m.keyboard = invalid
    m.top.setFocus(true)
end sub

sub onName()
    name = m.keyboard.text.Trim()
    if not speshProfiles.ValidName(name)
        m.status.text = "Enter a name between 1 and 24 characters."
        return
    end if
    m.edit.name = name
    closeKeyboard()
    m.index = 0
    for i = 0 to 7
        if speshProfiles.Avatars()[i] = m.edit.avatar then m.index = i
    end for
    m.mode = "avatars"
    draw()
end sub

sub onNameCancelled()
    closeKeyboard()
    m.index = m.returnIndex
    m.mode = "profiles"
    draw()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return true
    if m.mode = "keyboard" then return false
    if key = "back"
        if m.mode = "avatars" or m.manage
            if m.mode = "avatars" then m.index = m.returnIndex
            m.mode = "profiles"
            m.manage = false
            draw()
        else
            if isValid(m.task) then m.task.unobserveField("reply")
            m.top.cancelled = true
        end if
        return true
    end if
    if m.busy then return true
    if m.compatible
        if key = "OK" then m.top.selected = {profile:{id:"main",name:"Profile 1",avatar:"blue",isPrimary:true},userId:m.top.owner.id,accessToken:invalid,user:m.top.owner}
        return true
    end if
    if key = "options" then requestProfiles("list")
    count = m.profiles.count()
    if count < 3 then count++
    if m.mode = "avatars" then count = 8
    if key = "left" and m.index > 0 then m.index--
    if key = "right" and m.index < count - 1 then m.index++
    if key = "up" and m.mode = "avatars" and m.index >= 4 then m.index -= 4
    if key = "down"
        if m.mode = "avatars" and m.index < 4 then m.index += 4 else m.manage = not m.manage
    end if
    if key = "OK"
        if m.mode = "avatars"
            op = m.edit.id = "" ? "create" : "edit"
            requestProfiles(op)
        else if m.index >= m.profiles.count() or m.manage
            m.returnIndex = m.index
            if m.index < m.profiles.count() then m.edit = m.profiles[m.index] else m.edit = {id:"",name:"",avatar:"blue"}
            editName()
        else
            requestProfiles("select")
        end if
        return true
    end if
    draw()
    return true
end function
