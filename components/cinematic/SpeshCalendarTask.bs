import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/speshCalendar.bs"
import "pkg:/source/utils/parentalControls.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/config.bs"

sub init()
    m.top.functionName = "load"
end sub

sub load()
    r = m.top.request
    entries = []
    error = ""
    try
        if kidsMode.Enabled() then throw "Calendar unavailable in kids mode"
        if r.source = "Jellyfin"
            data = getJsonWithin(APIRequest("/Items", { UserId: m.global.session.user.id, IncludeItemTypes: "Movie,Episode", Recursive: true, MinPremiereDate: r.start + "T00:00:00Z", MaxPremiereDate: r.finish + "T23:59:59Z", SortBy: "PremiereDate", SortOrder: "Ascending", Limit: 1000, EnableTotalRecordCount: false, Fields: "PremiereDate,SeriesName,Overview,ProviderIds,ParentBackdropItemId,ParentBackdropImageTags" }), 15000)
            if not isValid(data) or not isValid(data.Items) then throw "Library source unavailable"
            for each item in parentalControls.WithoutBlockedItems(data.Items)
                iso = toString(item.PremiereDate)
                if iso = "" then continue for
                tv = LCase(toString(item.Type)) = "episode"
                title = toString(item.SeriesName ?? item.Name)
                art = ""
                if isValidAndNotEmpty(item.BackdropImageTags)
                    art = get_url() + "/Items/" + item.Id + "/Images/Backdrop/0?maxWidth=640"
                else if isValidAndNotEmpty(item.ParentBackdropItemId)
                    art = get_url() + "/Items/" + item.ParentBackdropItemId + "/Images/Backdrop/0?maxWidth=640"
                else if isValid(chainLookup(item, "ImageTags.Primary"))
                    art = get_url() + "/Items/" + item.Id + "/Images/Primary?maxWidth=400"
                end if
                episodeKey = ""
                if tv then episodeKey = LCase(title) + "|" + toString(item.ParentIndexNumber) + "|" + toString(item.IndexNumber)
                appendEntry(entries, item, iso, false, tv, title, toString(item.Name) + " · Library", art, item.Id, episodeKey)
            end for
        else
            boundary = CreateObject("roDateTime")
            boundary.FromISO8601String(r.start + "T00:00:00Z")
            boundary.FromSeconds(boundary.AsSeconds() - 86400)
            queryStart = Left(boundary.ToISOString(), 10)
            boundary.FromISO8601String(r.finish + "T00:00:00Z")
            boundary.FromSeconds(boundary.AsSeconds() + 86400)
            queryEnd = Left(boundary.ToISOString(), 10)
            data = getJsonWithin(APIRequest("/Moonfin/Seerr/" + r.source + "/Calendar", { start: queryStart, end: queryEnd }), 65000)
            if LCase(type(data)) <> "roarray" and LCase(type(data)) <> "array" then throw "Source unavailable or not configured"
            for each item in data
                if r.source = "Sonarr"
                    series = item.series
                    if not isValid(series) then continue for
                    iso = toString(item.airDateUtc)
                    timed = speshCalendar.HasTime(iso)
                    if not timed then iso = toString(item.airDate)
                    if iso = "" then continue for
                    detail = "S" + toString(item.seasonNumber) + " · E" + toString(item.episodeNumber) + " · " + toString(item.title)
                    localId = toString(item.moonfinEpisodeId ?? item.moonfinItemId)
                    episodeKey = LCase(toString(series.title)) + "|" + toString(item.seasonNumber) + "|" + toString(item.episodeNumber)
                    appendEntry(entries, series, iso, timed, true, toString(series.title), detail, speshCalendar.Artwork(series), localId, episodeKey)
                else
                    for each kind in ["digitalRelease", "physicalRelease", "inCinemas"]
                        iso = toString(item[kind])
                        if iso <> "" then appendEntry(entries, item, iso, false, false, toString(item.title), kind + " · Radarr", speshCalendar.Artwork(item), toString(item.moonfinItemId))
                    end for
                end if
            end for
        end if
    catch e
        error = r.source + ": unavailable. Other sources remain visible."
    end try
    m.top.answer = { source: r.source, entries: entries, error: error, scope: r.scope }
end sub

sub appendEntry(entries as object, item as object, iso as string, timed as boolean, tv as boolean, title as string, detail as string, art as string, localId as string, episodeKey = "" as string)
    date = speshCalendar.Eastern(iso, timed)
    key = LCase(title) + "|" + date.day + "|" + detail
    entries.push({ key: key, episodeKey:episodeKey, title: title, subtitle: date.clock + " · " + detail, day: date.day, sort: date.sort, tv: tv, art: art, localId: localId, tmdbId: toString(item.tmdbId ?? chainLookup(item,"ProviderIds.Tmdb")), tvdbId: toString(item.tvdbId), name: title })
end sub
