import "pkg:/source/utils/speshServices.bs"
import "pkg:/source/utils/seerrBrowseRows.bs"
import "pkg:/source/utils/kidsMode.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.grid = m.top.findNode("services")
    m.grid.observeField("itemSelected", "onServiceSelected")
    m.services = speshServices.All()
    content = CreateObject("roSGNode", "ContentNode")
    for each service in m.services
        item = content.createChild("ContentNode")
        item.title = service.name
        item.hdPosterUrl = "pkg:/images/services/" + service.icon + ".png"
    end for
    m.grid.content = content
end sub

sub OnScreenShown(_returning = false as boolean)
    m.grid.setFocus(true)
end sub

sub onServiceSelected(event as object)
    if kidsMode.Enabled() then return
    index = event.getData()
    if index < 0 or index >= m.services.count() then return
    service = m.services[index]
    m.global.sceneManager.callFunc("pushScene", seerrBrowseRows.BrowseScreenFor("network", service.id, service.name, "tv"))
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back"
        m.global.sceneManager.callFunc("popScene")
        return true
    end if
    if key = "up" and m.grid.itemFocused < 3 then return FocusNav(m.top)
    return false
end function
