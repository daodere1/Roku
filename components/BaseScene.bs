import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/themeApply.bs"

sub init()
    m.top.backgroundURI = ""
    resetProfileViews()
end sub

sub resetProfileViews()
    ' The XML ID dictionary retains removed nodes: keep its content anchor attached.
    content = m.top.findNode("content")
    content.removeChildrenIndex(content.getChildCount(), 0)
    for each child in m.top.getChildren(-1, 0)
        if not child.isSameNode(content) then m.top.removeChild(child)
    end for
    for each item in [{id:"overhang",kind:"JFOverhang"},{id:"sidebar",kind:"Sidebar"},{id:"spinner",kind:"Spinner"},{id:"tvKeyboard",kind:"TVKeyboard"},{id:"accountDialog",kind:"AccountDialog"},{id:"seerrTagsDialog",kind:"SeerrTagsDialog"},{id:"notificationBanner",kind:"NotificationBanner"}]
        node = m.top.createChild(item.kind)
        node.id = item.id
        if item.id = "sidebar" or item.id = "spinner" or item.id = "tvKeyboard" or item.id = "accountDialog" or item.id = "seerrTagsDialog" then node.visible = false
        if item.id = "spinner"
            node.translation = [897,477]
            m.spinner = node
        end if
    end for
    errorLabel = m.top.createChild("Label")
    errorLabel.setFields({id:"profileStartupError",translation:[220,360],width:1480,height:300,text:"Unable to start profiles. Reopen SpeshTV. Press Back to exit.",wrap:true,maxLines:5,horizAlign:"center",color:"#F3F5F6",visible:false})
    themeApply.ApplyToItem(m.top)
    m.top.disableRemote = false
    m.top.isLoading = false
    if not content.getParent().isSameNode(m.top) then m.top.appendChild(content)
    m.top.profileStartupFailed = false
    m.top.visible = true
end sub

' Triggered when the isLoading boolean component field is changed
sub isLoadingChanged()
    m.spinner.visible = m.top.isLoading
end sub

sub onJumpToChange()
    if not isValidAndNotEmpty(m.top.jumpTo) then return
    if not isValid(m.top.jumpTo.selectiontype) then return

    m.global.jumpTo = m.top.jumpTo
    m.top.jumpTo = {}
end sub

' Triggered when the disableRemote boolean component field is changed
sub disableRemoteChanged()
    if m.top.disableRemote
        dialog = createObject("roSGNode", "ProgressDialog")
        dialog.id = "invisibiledialog"
        dialog.visible = false
        dialog.opacity = 0
        m.top.dialog = dialog
    else
        if isValid(m.top.dialog)
            m.top.dialog.close = true
        end if
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.top.profileStartupFailed
        if key = "back" then m.top.exit = true
        return true
    end if

    if key = "back"
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    if key = "options"
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group) and isValid(group.optionsAvailable) and group.optionsAvailable
            group.lastFocus = group.focusedChild

            scene = m.top.getScene()
            if isValid(scene)
                activeNav = getActiveNav(scene)
                if isValid(activeNav)
                    overlayCurrentUserSelection = activeNav.findNode("overlayCurrentUserSelection")
                    if isValid(overlayCurrentUserSelection) and overlayCurrentUserSelection.visible
                        group.lastFocus = activeNav
                    end if
                end if
            end if

            if group.isSubType("Home") then return true

            panel = group.findNode("options")
            panel.visible = true
            panel.findNode("panelList").setFocus(true)

        end if
        return true
    end if

    if key = KeyCode.REPLAY
        focusAudioMiniPlayer()
        return true
    end if

    if key = KeyCode.LEFT
        scene = m.top.getScene()
        if isValid(scene)
            sidebar = scene.findNode("sidebar")
            if isValid(sidebar) and sidebar.visible
                sidebar.setFocus(true)
                return true
            end if
        end if
    end if

    return false
end function
