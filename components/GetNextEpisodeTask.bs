import "pkg:/source/utils/profileTaskIdentity.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/speshProgress.brs"

sub init()
    profileTaskIdentity.Capture()
    m.top.functionName = "getNextEpisodeTask"
end sub

sub getNextEpisodeTask()
    m.nextEpisodeData = api.shows.GetEpisodes(m.top.showID, {
        UserId: m.global.session.user.id,
        EnableTotalRecordCount: false,
        IsMissing: false,
        Fields: "Path,UserData",
        EnableUserData: true
    })

    if m.nextEpisodeData <> invalid and m.nextEpisodeData.Items <> invalid
        m.nextEpisodeData.Items = speshDedupeEpisodeQueue(m.nextEpisodeData.Items, m.top.videoID)
        preferLocalEpisodes()
    end if
    m.top.nextEpisodeData = m.nextEpisodeData
end sub

sub preferLocalEpisodes()
    hasVod = false
    for each item in m.nextEpisodeData.Items
        if speshSourceRank(item) = 0 then hasVod = true
    end for
    if not hasVod then return

    userId = m.global.session.user.id
    series = getJsonWithin(APIRequest("Items/" + m.top.showID, { UserId: userId }), 2500)
    if series = invalid or series.ProviderIds = invalid or series.Name = invalid then return
    languageSuffix = CreateObject("roRegex", "\s*\((english|spanish|chinese|japanese|korean)\)\s*$", "i")
    searchName = languageSuffix.Replace(series.Name, "")
    candidates = getJsonWithin(APIRequest("Items", {
        UserId: userId, Recursive: true, IncludeItemTypes: "Series",
        SearchTerm: searchName, Fields: "ProviderIds", Limit: 8, EnableTotalRecordCount: false
    }), 2500)
    if candidates = invalid or candidates.Items = invalid then return

    checked = 0
    for each candidate in candidates.Items
        if candidate.Id <> m.top.showID and speshSameSeries(series, candidate)
            copies = getJsonWithin(APIRequest("Shows/" + candidate.Id + "/Episodes", {
                UserId: userId, IsMissing: false, Fields: "Path,UserData",
                EnableUserData: true, EnableTotalRecordCount: false
            }), 2500)
            if copies <> invalid and copies.Items <> invalid
                m.nextEpisodeData.Items = speshPreferEpisodeCopies(m.nextEpisodeData.Items, copies.Items, m.top.videoID)
            end if
            checked++
            if checked >= 2 then exit for
        end if
    end for
end sub
